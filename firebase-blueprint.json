{
  "entities": {
    "User": {
      "title": "User",
      "description": "A professional or administrator in the clinic",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "professional"] },
        "professionalId": { "type": "string", "description": "CRM, CRP, etc." },
        "specialty": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Patient": {
      "title": "Patient",
      "description": "A patient registered in the clinic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "rg": { "type": "string" },
        "birthDate": { "type": "string" },
        "birthPlace": { "type": "string" },
        "maritalStatus": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "healthInsuranceName": { "type": "string" },
        "healthInsuranceNumber": { "type": "string" },
        "assignedProfessionalId": { "type": "string", "description": "UID of the professional assigned to this patient" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "assignedProfessionalId", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled appointment for a patient with a professional",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "professionalId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "office": { "type": "string", "description": "Consultório" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "patientName", "professionalId", "date", "duration", "office", "status", "createdAt"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "A medical record entry for a patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "professionalId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "professionalId", "date", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of users (professionals and admins)"
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Collection of patients"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Collection of appointments"
    },
    "/medicalRecords/{recordId}": {
      "schema": { "$ref": "#/entities/MedicalRecord" },
      "description": "Collection of medical records"
    }
  }
}
