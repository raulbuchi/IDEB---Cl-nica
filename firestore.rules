rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // ===============================================================
    // Primitives
    // ===============================================================

    function isAuthenticated() {
      // Must be authenticated and verified
      return request.auth != null && (request.auth.token.email_verified == true || request.auth.token.email == "demo@ideb.com" || request.auth.token.email == "rbuchi@gmail.com");
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == "rbuchi@gmail.com" ||
        request.auth.token.email == "demo@ideb.com"
      );
    }

    function isProfessional() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'professional'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    // ===============================================================
    // Validation Blueprints
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
             data.role in ['admin', 'professional'] &&
             (data.get('professionalId', '') is string && data.get('professionalId', '').size() <= 50) &&
             (data.get('specialty', '') is string && data.get('specialty', '').size() <= 100) &&
             (data.get('phone', '') is string && data.get('phone', '').size() <= 20) &&
             (data.get('rg', '') is string && data.get('rg', '').size() <= 20) &&
             (data.get('cpfCnpj', '') is string && data.get('cpfCnpj', '').size() <= 20) &&
             (data.get('address', '') is string && data.get('address', '').size() <= 200) &&
             (data.get('socialMedia', '') is string && data.get('socialMedia', '').size() <= 200) &&
             data.createdAt is timestamp;
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['name', 'assignedProfessionalId', 'createdAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             (data.get('cpf', '') is string && data.get('cpf', '').size() <= 20) &&
             (data.get('rg', '') is string && data.get('rg', '').size() <= 20) &&
             (data.get('birthDate', '') is string && data.get('birthDate', '').size() <= 20) &&
             (data.get('birthPlace', '') is string && data.get('birthPlace', '').size() <= 100) &&
             (data.get('maritalStatus', '') is string && data.get('maritalStatus', '').size() <= 50) &&
             (data.get('phone', '') is string && data.get('phone', '').size() <= 20) &&
             (data.get('email', '') is string && data.get('email', '').size() <= 100) &&
             (data.get('address', '') is string && data.get('address', '').size() <= 200) &&
             (data.get('healthInsuranceName', '') is string && data.get('healthInsuranceName', '').size() <= 100) &&
             (data.get('healthInsuranceNumber', '') is string && data.get('healthInsuranceNumber', '').size() <= 100) &&
             data.assignedProfessionalId is string && data.assignedProfessionalId.size() >= 1 && data.assignedProfessionalId.size() <= 128 &&
             data.createdAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'patientName', 'professionalId', 'date', 'duration', 'office', 'status', 'createdAt']) &&
             data.patientId is string && data.patientId.size() >= 1 && data.patientId.size() <= 128 &&
             data.patientName is string && data.patientName.size() >= 1 && data.patientName.size() <= 100 &&
             data.professionalId is string && data.professionalId.size() >= 1 && data.professionalId.size() <= 128 &&
             data.date is timestamp &&
             data.duration is number && data.duration > 0 &&
             data.office is string && data.office.size() >= 1 && data.office.size() <= 100 &&
             data.status in ['scheduled', 'completed', 'cancelled'] &&
             (data.get('notes', '') is string && data.get('notes', '').size() <= 1000) &&
             (data.get('reminderTiming', '') is string && data.get('reminderTiming', '').size() <= 20) &&
             data.createdAt is timestamp;
    }

    function isValidMedicalRecord(data) {
      return data.keys().hasAll(['patientId', 'professionalId', 'date', 'content', 'createdAt']) &&
             data.patientId is string && data.patientId.size() >= 1 && data.patientId.size() <= 128 &&
             data.professionalId is string && data.professionalId.size() >= 1 && data.professionalId.size() <= 128 &&
             data.date is timestamp &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 10000 &&
             data.createdAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['amount', 'date', 'method', 'patientId', 'patientName', 'professionalId', 'professionalName', 'createdAt']) &&
             data.amount is number && data.amount > 0 &&
             data.date is timestamp &&
             data.method in ['pix', 'cash', 'credit_card', 'debit_card', 'health_insurance'] &&
             (data.get('methodDetails', '') is string && data.get('methodDetails', '').size() <= 500) &&
             data.patientId is string && data.patientId.size() >= 1 && data.patientId.size() <= 128 &&
             data.patientName is string && data.patientName.size() >= 1 && data.patientName.size() <= 100 &&
             data.professionalId is string && data.professionalId.size() >= 1 && data.professionalId.size() <= 128 &&
             data.professionalName is string && data.professionalName.size() >= 1 && data.professionalName.size() <= 100 &&
             data.createdAt is timestamp;
    }

    function isValidAttachment(data) {
      return data.keys().hasAll(['patientId', 'professionalId', 'name', 'type', 'createdAt']) &&
             data.patientId is string && data.patientId.size() >= 1 && data.patientId.size() <= 128 &&
             data.professionalId is string && data.professionalId.size() >= 1 && data.professionalId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.type in ['exam', 'test', 'opinion', 'certificate', 'other'] &&
             (data.get('url', '') is string && data.get('url', '').size() <= 2000) &&
             (data.get('fileData', '') is string && data.get('fileData', '').size() <= 1048000) &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules Configuration
    // ===============================================================

    match /users/{userId} {
      allow get: if isAuthenticated() && isValidId(userId);
      allow list: if isAuthenticated(); // Admins and Users need to list users for dropdowns
      
      allow create: if isAuthenticated() && isValidId(userId) && isValidUser(incoming()) && (
        (incoming().uid == request.auth.uid && incoming().uid == userId && incoming().role == 'professional') || 
        isAdmin()
      ) && incoming().createdAt == request.time;
      
      allow update: if isAuthenticated() && isValidId(userId) && isValidUser(incoming()) && (
        incoming().uid == existing().uid && 
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() || 
          (isOwner(userId) && incoming().role == existing().role)
        )
      );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /patients/{patientId} {
      allow get: if isAuthenticated() && isValidId(patientId) && (isAdmin() || existing().assignedProfessionalId == request.auth.uid);
      allow list: if isAuthenticated() && (isAdmin() || resource.data.assignedProfessionalId == request.auth.uid);
      
      allow create: if isAuthenticated() && isValidPatient(incoming()) && (
        isAdmin() || incoming().assignedProfessionalId == request.auth.uid
      ) && incoming().createdAt == request.time;

      allow update: if isAuthenticated() && isValidId(patientId) && isValidPatient(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() || 
          (existing().assignedProfessionalId == request.auth.uid && incoming().assignedProfessionalId == existing().assignedProfessionalId)
        )
      );

      allow delete: if isAdmin() && isValidId(patientId);
    }

    match /appointments/{appointmentId} {
      allow get: if isAuthenticated() && isValidId(appointmentId) && (isAdmin() || existing().professionalId == request.auth.uid);
      allow list: if isAuthenticated() && (isAdmin() || resource.data.professionalId == request.auth.uid);
      
      allow create: if isAuthenticated() && isValidAppointment(incoming()) && (
        isAdmin() || incoming().professionalId == request.auth.uid
      ) && incoming().createdAt == request.time;

      allow update: if isAuthenticated() && isValidId(appointmentId) && isValidAppointment(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() || 
          (existing().professionalId == request.auth.uid && incoming().professionalId == existing().professionalId)
        )
      );

      allow delete: if isAuthenticated() && isValidId(appointmentId) && (isAdmin() || existing().professionalId == request.auth.uid);
    }

    match /medicalRecords/{recordId} {
      allow get: if isAuthenticated() && isValidId(recordId) && (isAdmin() || existing().professionalId == request.auth.uid);
      allow list: if isAuthenticated() && (isAdmin() || resource.data.professionalId == request.auth.uid);

      allow create: if isAuthenticated() && isValidMedicalRecord(incoming()) && (
        isAdmin() || incoming().professionalId == request.auth.uid
      ) && incoming().createdAt == request.time;

      allow update: if isAuthenticated() && isValidId(recordId) && isValidMedicalRecord(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        incoming().professionalId == existing().professionalId &&
        incoming().patientId == existing().patientId &&
        (isAdmin() || existing().professionalId == request.auth.uid)
      );

      allow delete: if isAdmin() && isValidId(recordId);
    }

    match /payments/{paymentId} {
      allow get: if isAuthenticated() && isValidId(paymentId) && (isAdmin() || existing().professionalId == request.auth.uid);
      allow list: if isAuthenticated() && (isAdmin() || resource.data.professionalId == request.auth.uid);

      allow create: if isAuthenticated() && isValidPayment(incoming()) && (
        isAdmin() || incoming().professionalId == request.auth.uid
      ) && incoming().createdAt == request.time;

      allow update: if isAuthenticated() && isValidId(paymentId) && isValidPayment(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() || 
          (existing().professionalId == request.auth.uid && incoming().professionalId == existing().professionalId)
        )
      );

      allow delete: if isAuthenticated() && isValidId(paymentId) && (isAdmin() || existing().professionalId == request.auth.uid);
    }

    match /attachments/{attachmentId} {
      allow get: if isAuthenticated() && isValidId(attachmentId) && (isAdmin() || existing().professionalId == request.auth.uid);
      allow list: if isAuthenticated() && (isAdmin() || resource.data.professionalId == request.auth.uid);

      allow create: if isAuthenticated() && isValidAttachment(incoming()) && (
        isAdmin() || incoming().professionalId == request.auth.uid
      ) && incoming().createdAt == request.time;

      allow update: if isAuthenticated() && isValidId(attachmentId) && isValidAttachment(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        incoming().professionalId == existing().professionalId &&
        incoming().patientId == existing().patientId &&
        (isAdmin() || existing().professionalId == request.auth.uid)
      );

      allow delete: if isAdmin() || (isAuthenticated() && existing().professionalId == request.auth.uid);
    }

  }
}
